# Required: topic subscribed in the ntfy Android/iOS app.
CODEX_NOTIFY_NTFY_TOPIC=replace-with-a-long-random-topic

# Optional. Self-hosted ntfy is supported.
CODEX_NOTIFY_NTFY_SERVER=https://ntfy.sh
# CODEX_NOTIFY_NTFY_TOKEN=tk_example

# Poll Codex app-server once per minute.
CODEX_NOTIFY_INTERVAL_SECS=60
